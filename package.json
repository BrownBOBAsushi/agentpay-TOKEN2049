{
  "name": "agentpay-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker/index.ts",
    "worker:reconcile": "node --env-file-if-exists=.env.local --import tsx src/worker/reconcile.ts",
    "orchestrator": "node --env-file-if-exists=.env.local --import tsx src/orchestrator/index.ts",
    "demo-seller": "node --env-file-if-exists=.env.local --import tsx src/demo-seller/index.ts",
    "demo:mandate": "node --env-file-if-exists=.env.local --import tsx src/orchestrator/mandate.ts"
  },
  "dependencies": {
    "@evolution-sdk/evolution": "0.5.17",
    "@x402/cardano": "2.26.0",
    "@x402/core": "2.26.0",
    "@x402/express": "2.26.0",
    "@x402/fetch": "2.26.0",
    "canonicalize": "5.1.0",
    "express": "5.2.1",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/express": "5.0.6",
    "@types/node": "26.6.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
