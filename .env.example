# Preprod only. Copy to .env.local. Never commit real values.

# --- Cardano ---
CARDANO_NETWORK=preprod
BLOCKFROST_API_KEY_PREPROD=
TUSDM_UNIT=16a55b2a349361ff88c03788f93e1e966e5d689605d044fef722ddde0014df10745553444d

# --- Sokosumi Coworker ---
SOKOSUMI_API_URL=https://api.preprod.sokosumi.com/v1
SOKOSUMI_COWORKER_API_KEY=
SOKOSUMI_COWORKER_ID=
# Empty uses the default 10000 ms; polling must be at least 10 seconds.
POLL_INTERVAL_MS=
SOKOSUMI_VENDOR_ID=

# --- Masumi Payment Service (self-hosted) ---
MPS_BASE_URL=http://127.0.0.1:3012/api/v1
MPS_RUNTIME_TOKEN=
MASUMI_AGENT_IDENTIFIER=
MASUMI_SUPPORTED_PAYMENT_SOURCE_INDEX=
# Empty keeps new Tasks free; true enables paid Tasks. Existing Tasks keep their saved mode.
PAID_TASKS_ENABLED=
# Empty uses offsets of 20, 60, 75, and 90 minutes. Values must strictly increase.
PAID_PAY_BY_MINUTES=
PAID_SUBMIT_RESULT_MINUTES=
PAID_UNLOCK_MINUTES=
PAID_DISPUTE_MINUTES=
MASUMI_SELLER_VKEY=
MASUMI_SELLER_ADDRESS=

# --- Guard ---
# Guard Key holds no funds and is separate from every wallet.
# GUARD_SIGNING_KEY: hex Ed25519 private key, preprod only.
GUARD_SIGNING_KEY=
# GUARD_ADDRESS: preprod addr_test1 address for the Guard Key.
GUARD_ADDRESS=
DATABASE_URL=

# --- x402 (demo Orchestrator + demo seller) ---
X402_FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
DEMO_SELLER_PORT=4021
ORCHESTRATOR_WALLET_MNEMONIC=
DEMO_SELLER_ADDRESS=

# --- Private store live mode (server only, at least 32 characters) ---
# Uses the Orchestrator mnemonic, Blockfrost preprod key, facilitator and Sokosumi variables above.
STORE_LIVE_KEY=

# --- Model provider for the Orchestrator ---
MODEL_API_KEY=

# Public preprod tUSDM asset unit for the Mandate form
NEXT_PUBLIC_TUSDM_UNIT=
